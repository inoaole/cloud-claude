# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# ── Hub server ───────────────────────────────────────────────
# Port the hub listens on (fronted by `tailscale serve` for HTTPS).
HUB_PORT=8080

# ── Auth ─────────────────────────────────────────────────────
# PIN required to unlock the PWA from the phone.
HUB_PIN=change-me
# Secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
# Session lifetime.
SESSION_TTL=7d

# ── Devices ──────────────────────────────────────────────────
# Device registry (gitignored — holds host/user/ssh-key per machine).
# Copy devices.example.json -> devices.json and fill in your machines.
DEVICES_FILE=./devices.json

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
